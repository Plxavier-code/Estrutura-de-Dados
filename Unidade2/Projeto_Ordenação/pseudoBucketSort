//pseudocodigo Bucket Sort:

FUNCTION BucketSort(A, NBuckets)
    criar lista de buckets B[0..NBuckets-1]  // cada B[i] é lista vazia
    FOR each x in A DO
        index = bucket_index(x, NBuckets)    // função de mapeamento
        append x to B[index]
    END FOR

    FOR i = 0 to NBuckets-1 DO
        sort(B[i])                           // exemplo: insertion sort
    END FOR

    result = empty list
    FOR i = 0 to NBuckets-1 DO
        FOR each y in B[i] DO
            append y to result
        END FOR
    END FOR

    RETURN result
END FUNCTION



